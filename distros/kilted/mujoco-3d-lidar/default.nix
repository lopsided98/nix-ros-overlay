{ lib, buildRosPackage, fetchurl, ament-cmake, mujoco-vendor }:
buildRosPackage {
  pname = "ros-kilted-mujoco-3d-lidar";
  version = "0.1.3-r1";

  src = fetchurl {
    url = "https://github.com/ros2-gbp/mujoco_ros2_control-release/archive/release/kilted/mujoco_3d_lidar/0.1.3-1.tar.gz";
    name = "0.1.3-1.tar.gz";
    sha256 = "ad1abe790676ffd006dd20d4dcc3d6796b7666f634528a2332ebbf3555ec95b1";
  };

  buildType = "ament_cmake";
  buildInputs = [ ament-cmake ];
  propagatedBuildInputs = [ mujoco-vendor ];
  nativeBuildInputs = [ ament-cmake ];

  meta = {
    description = "Plugin for mujoco to use raycasters to simulate lidar";
    license = with lib.licenses; [ asl20 ];
  };
}
