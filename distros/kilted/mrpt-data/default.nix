{ lib, buildRosPackage, fetchurl, cmake }:
buildRosPackage {
  pname = "ros-kilted-mrpt-data";
  version = "3.2.0-r1";

  src = fetchurl {
    url = "https://github.com/ros2-gbp/mrpt3-release/archive/release/kilted/mrpt_data/3.2.0-1.tar.gz";
    name = "3.2.0-1.tar.gz";
    sha256 = "ce8688269a0bf39b72777c5753427c3e6a0f6a6e6bd46ad1fcc3ee482bef5100";
  };

  buildType = "cmake";
  buildInputs = [ cmake ];
  nativeBuildInputs = [ cmake ];

  meta = {
    description = "MRPT shared data files: test datasets and example config files";
    license = with lib.licenses; [ bsdOriginal ];
  };
}
